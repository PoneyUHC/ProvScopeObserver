
tracepoint:syscalls:sys_enter_write
/ curtask->parent->pid == $1 /
{
    @entered_write[pid] = 1;

    @fd[pid] = args->fd;
    @buf[pid] = args->buf;
    @count[pid] = args->count;

    @size[pid] = @count[pid] > 128 ? 128 : @count[pid];
}


tracepoint:syscalls:sys_exit_write
/ @entered_write[pid] == 1 /
{
    $ret = args->ret;

    printf("%s---%d---%d---%r\n", comm, pid, @count[pid], buf(@buf[pid], @size[pid]));
}
