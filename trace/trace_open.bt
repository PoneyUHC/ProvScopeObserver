
#include <fcntl.h>

tracepoint:syscalls:sys_enter_openat
/ curtask->parent->pid == $1 /
{
    @entered_open[pid] = 1;

    @mode[pid] = args->mode;
    @filename[pid] = str(args->filename);

    @access_mode[pid] = args->flags & O_ACCMODE;
}


tracepoint:syscalls:sys_exit_openat
/@entered_open[pid] == 1/
{
    printf("%ld---%s---%d---%s---%ld---%d---%d\n", nsecs, comm, pid, @filename[pid], args->ret, @mode[pid], @access_mode[pid]);

    delete(@entered_open[pid]);
    delete(@mode[pid]);
    delete(@filename[pid]);
    delete(@access_mode[pid]);
}

END 
{
    clear(@entered_open);
    clear(@mode);
    clear(@filename);
    clear(@access_mode);
}