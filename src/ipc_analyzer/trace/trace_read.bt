
tracepoint:syscalls:sys_enter_read
/ curtask->parent->pid == $1 /
{
    @entered_read[pid] = 1;

    @fd[pid] = args->fd;
    @buf[pid] = args->buf;
    @count[pid] = args->count;

    @size[pid] = @count[pid] > 128 ? 128 : @count[pid];
}


tracepoint:syscalls:sys_exit_read
/ @entered_read[pid] == 1 /
{
    $ret = args->ret;

    printf("%ld---%s---%d---%d---%d---%r\n", nsecs, comm, pid, @fd[pid], @count[pid], buf(@buf[pid], @size[pid]));

    delete(@entered_read[pid]);
    delete(@fd[pid]);
    delete(@buf[pid]);
    delete(@count[pid]);
    delete(@size[pid]);
}


END 
{
    clear(@entered_read);
    clear(@fd);
    clear(@buf);
    clear(@count);
    clear(@size);
}
