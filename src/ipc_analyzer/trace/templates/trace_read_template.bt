
tracepoint:syscalls:sys_enter_read
/ [TEMPLATE_PROCESS_NAMES] /
{
    @entered_read[pid] = 1;

    @fd[pid] = args->fd;
    @buf[pid] = args->buf;
    @count[pid] = args->count;

    @size[pid] = @count[pid] > 128 ? 128 : @count[pid];

    printf("enter---%ld---%s---%d---%d---%d\n", nsecs, comm, pid, @fd[pid], @count[pid]);
}


tracepoint:syscalls:sys_exit_read
/ @entered_read[pid] == 1 /
{
    printf("exit---%ld---%s---%d---%d---%d---%r---%d\n", nsecs, comm, pid, @fd[pid], @count[pid], buf(@buf[pid], @size[pid]), args->ret);

    delete(@entered_read[pid]);
    delete(@fd[pid]);
    delete(@buf[pid]);
    delete(@count[pid]);
    delete(@size[pid]);
}


END 
{
    clear(@entered_read);
    clear(@fd);
    clear(@buf);
    clear(@count);
    clear(@size);
}
