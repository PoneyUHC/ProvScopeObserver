#include <fcntl.h>

[TEMPLATE_CONFIG]

BEGIN
{
    @next_close_id = 1;
}

tracepoint:syscalls:sys_enter_close
/ [TEMPLATE_PROCESS_NAMES] /
{
    $seq = @next_write_id++;
    $id = pid << 32 | $seq;

    @close_id[pid] = $id;
    @fd[pid] = args->fd;
}

tracepoint:syscalls:sys_exit_close
/@close_id[pid]/
{
    // Allocate a unique event id (one entry per close())
    $id = @close_id[pid];
    
    @close_events[$id] = (
        nsecs, 
        comm, 
        pid, 
        @fd[pid], 
        args->ret
    );

    // Clean up per-pid temporary state
    delete(@close_id[pid]);
    delete(@fd[pid]);
}

END
{
    print(@close_events);

    clear(@close_events);

    clear(@close_id);
    clear(@fd);
    clear(@next_close_id);
}
