#include <fcntl.h>

[TEMPLATE_CONFIG]

BEGIN
{
    @next_close_id = 1;
}

tracepoint:syscalls:sys_enter_close
/ [TEMPLATE_PROCESS_NAMES] /
{
    @entered_close[pid] = 1;
    @fd[pid] = args->fd;
}

tracepoint:syscalls:sys_exit_close
/@entered_close[pid] == 1/
{
    // Allocate a unique event id (one entry per close())
    $id = @next_close_id++;
    
    @close_events[$id] = (
        nsecs, 
        comm, 
        pid, 
        @fd[pid], 
        args->ret
    );

    // Clean up per-pid temporary state
    delete(@entered_close[pid]);
    delete(@fd[pid]);
}

END
{
    print(@close_events);

    clear(@close_events);

    clear(@entered_close);
    clear(@fd);
    clear(@next_close_id);
}
