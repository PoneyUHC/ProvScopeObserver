

config = {
	max_map_keys = 65535;
	print_maps_on_exit = 0;
	max_strlen = 150
}




BEGIN
{
    @next_write_id = 1;
}

tracepoint:syscalls:sys_enter_write
/ comm == "router.bin" || comm == "client.bin" || comm == "log_collector.b" || false /
{
    $seq = @next_write_id++;
    $id = pid << 32 | $seq;

    @write_event_id[pid] = $id;

    @fd_by_id[$id]    = args->fd;
    @count_by_id[$id] = args->count;

    @buf_ptr_by_id[$id] = args->buf;
}

tracepoint:syscalls:sys_exit_write
/ @write_event_id[pid] /
{
    $id = @write_event_id[pid];

    $ptr = @buf_ptr_by_id[$id];
    $len = args->ret > 100 ? 100 : args->ret;

    @write_buf[$id] = *(uint8[100]*)$ptr;

    @write_events[$id] = (
        nsecs,
        comm,
        pid,
        @fd_by_id[$id],
        @count_by_id[$id],
        args->ret
    );

    delete(@write_event_id[pid]);
    delete(@fd_by_id[$id]);
    delete(@count_by_id[$id]);
    delete(@buf_ptr_by_id[$id]);
}

END
{
    print(@write_events);
    print(@write_buf);

    clear(@write_events);
    clear(@write_buf);

    clear(@write_event_id);
    clear(@fd_by_id);
    clear(@count_by_id);
    clear(@buf_ptr_by_id);
    clear(@next_write_id);
}
