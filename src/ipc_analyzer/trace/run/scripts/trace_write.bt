
BEGIN
{
    @next_write_id = 1;
}


tracepoint:syscalls:sys_enter_write
/ comm == "router.bin" || comm == "client.bin" || comm == "log_collector.b" || false /
{
    $id = @next_write_id++;

    @write_event_id[pid] = $id;

    @fd_by_id[$id]    = args->fd;
    @count_by_id[$id] = args->count;

    @size_by_id[$id]    = args->count > 128 ? 128 : args->count;
    @buf_ptr_by_id[$id] = args->buf;
}


tracepoint:syscalls:sys_exit_write
/ @write_event_id[pid] /
{
    $id = @write_event_id[pid];

    @write_events[$id] = (
        nsecs, 
        comm, 
        pid, 
        @fd_by_id[$id], 
        @count_by_id[$id], 
        buf(@buf_ptr_by_id[$id], @size_by_id[$id]),
        args->ret
    );

    delete(@write_event_id[pid]);
    delete(@fd_by_id[$id]);
    delete(@buf_ptr_by_id[$id]);
    delete(@count_by_id[$id]);
    delete(@size_by_id[$id]);
}


END 
{
    clear(@write_event_id);
    clear(@fd_by_id);
    clear(@count_by_id);
    clear(@size_by_id);
    clear(@buf_ptr_by_id);
    clear(@next_write_id);
}
