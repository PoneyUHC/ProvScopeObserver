#include <fcntl.h>

config = {
	max_map_keys = 65535;
	print_maps_on_exit = 0;
	max_strlen = 150
}



BEGIN
{
    @next_close_id = 1;
}

tracepoint:syscalls:sys_enter_close
/ comm == "router.bin" || comm == "client.bin" || comm == "log_collector.b" || false /
{
    @entered_close[pid] = 1;
    @fd[pid] = args->fd;
}

tracepoint:syscalls:sys_exit_close
/@entered_close[pid] == 1/
{
    // Allocate a unique event id (one entry per close())
    $seq = @next_write_id++;
    $id = pid << 32 | $seq;
    
    @close_events[$id] = (
        nsecs, 
        comm, 
        pid, 
        @fd[pid], 
        args->ret
    );

    // Clean up per-pid temporary state
    delete(@entered_close[pid]);
    delete(@fd[pid]);
}

END
{
    print(@close_events);

    clear(@close_events);

    clear(@entered_close);
    clear(@fd);
    clear(@next_close_id);
}
