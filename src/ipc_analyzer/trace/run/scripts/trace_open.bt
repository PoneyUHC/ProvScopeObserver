#include <fcntl.h>
#include <uapi/linux/stat.h>

#define S_IFMT 00170000


config = {
	max_map_keys = 65535;
	print_maps_on_exit = 0;
	max_strlen = 150
}




BEGIN
{
    // Use 1 instead of 0 because map failed access yields 0
    // So we cannot differentiate failure and true 0 
    @next_open_id = 1;
}

tracepoint:syscalls:sys_enter_openat
/ comm == "router.bin" || comm == "client.bin" || comm == "log_collector.b" || false /
{
    $id = @next_open_id++;
    @open_id[pid] = $id;

    @mode[$id]        = args->mode;
    @filename[$id]    = str(args->filename);
    @access_mode[$id] = args->flags & O_ACCMODE;

    @vfs_open[pid] = $id;
}

kprobe:vfs_open
/@vfs_open[pid]/
{
    $id = @vfs_open[pid];

    $path = (struct path*)arg0;
    if ($path != 0 && $path->dentry != 0 && $path->dentry->d_inode != 0) {
        $mode = $path->dentry->d_inode->i_mode;
        @type[$id] = $mode & S_IFMT;
    }

    delete(@vfs_open[pid]);
}

tracepoint:syscalls:sys_exit_openat
/@open_id[pid]/
{
    $id = @open_id[pid];
    // Only scalar + small string (comm) data here
    @open_events[$id] = (
        nsecs,
        comm,
        pid, 
        args->ret,
        @mode[$id], 
        @access_mode[$id], 
        @type[$id]
    );

    delete(@open_id[pid]);
    delete(@mode[$id]);
    delete(@access_mode[$id]);
    delete(@type[$id]);
}

END
{
    print(@open_events);
    print(@filename);

    clear(@open_events);

    clear(@open_id);
    clear(@mode);
    clear(@access_mode);
    clear(@type);
    clear(@next_open_id);
}

