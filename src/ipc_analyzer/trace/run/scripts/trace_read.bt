
#include <fcntl.h>


config = {
	max_map_keys = 65535;
	print_maps_on_exit = 0;
	max_strlen = 150
}




BEGIN
{
    @next_read_id = 1;
}


tracepoint:syscalls:sys_enter_read
/ comm == "router.bin" || comm == "client.bin" || comm == "log_collector.b" || false /
{
    // Allocate a new event id
    $id = @next_read_id++;

    // Remember which event belongs to this pid for the exit probe
    @read_event_id[pid] = $id;

    // "enter" side info (per event)
    @fd_by_id[$id]    = args->fd;
    @count_by_id[$id] = args->count;

    // Buffer metadata (we’ll snapshot contents on exit)
    @size_by_id[$id]    = args->count > 100 ? 100 : args->count;
    @buf_ptr_by_id[$id] = args->buf;

    @enter_events[$id] = (nsecs, comm, pid, args->fd, args->count);
}


tracepoint:syscalls:sys_exit_read
/ @read_event_id[pid] /
{
    $id = @read_event_id[pid];

    $ptr = @buf_ptr_by_id[$id];
    $len = @size_by_id[$id];

    @read_buf[$id] = *(uint8[100]*)$ptr;

    @exit_events[$id] = (
        nsecs, 
        comm, 
        pid, 
        @fd_by_id[$id], 
        @count_by_id[$id],
        args->ret
    );

    delete(@read_event_id[pid]);
    delete(@fd_by_id[$id]);
    delete(@count_by_id[$id]);
    delete(@size_by_id[$id]);
    delete(@buf_ptr_by_id[$id]);
}


END
{
    print(@enter_events);
    print(@exit_events);
    print(@read_buf);

    clear(@enter_events);
    clear(@exit_events);
    clear(@read_buf);

    clear(@read_event_id);
    clear(@fd_by_id);
    clear(@count_by_id);
    clear(@size_by_id);
    clear(@buf_ptr_by_id);
    clear(@next_read_id);
}