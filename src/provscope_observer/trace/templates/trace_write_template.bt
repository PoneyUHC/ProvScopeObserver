

[TEMPLATE_CONFIG]


BEGIN
{
    @next_write_id = 1;
}

tracepoint:syscalls:sys_enter_write
/ [TEMPLATE_PROCESS_NAMES] /
{
    $seq = @next_write_id++;
    $id = pid << 32 | $seq;

    @write_event_id[pid] = $id;

    @fd_by_id[$id]    = args->fd;
    @count_by_id[$id] = args->count;

    @buf_ptr_by_id[$id] = args->buf;
}

tracepoint:syscalls:sys_exit_write
/ @write_event_id[pid] /
{
    $id = @write_event_id[pid];

    $ptr = @buf_ptr_by_id[$id];
    $len = args->ret < 0 ? 0 : args->ret;

    @write_buf[$id] = buf($ptr, $len);

    @write_events[$id] = (
        nsecs,
        comm,
        pid,
        @fd_by_id[$id],
        @count_by_id[$id],
        args->ret
    );

    delete(@write_event_id[pid]);
    delete(@fd_by_id[$id]);
    delete(@count_by_id[$id]);
    delete(@buf_ptr_by_id[$id]);


    // ----- USTACK GRATHERING -----
    // load process symbols once while the process is up
    if ( !@init[comm] ) {
        @garbage[comm] = ustack(perf, 1);
        print(@garbage[comm]);
        @init[comm] = 1;
    }

    // gather a user stack trace for this event
    @ustacks[$id] = ustack(perf, 5);
}

END
{
    print(@write_events);
    print(@write_buf);
    clear(@write_events);
    clear(@write_buf);

    print(@ustacks);
    clear(@ustacks);

    clear(@write_event_id);
    clear(@fd_by_id);
    clear(@count_by_id);
    clear(@buf_ptr_by_id);
    clear(@next_write_id);
}
