
#include <fcntl.h>

tracepoint:syscalls:sys_enter_openat 
/comm == "target.bin" || comm == "attacker.bin" || comm == "router.bin" || comm == "log_collector.b"/ 
{ 
    $mode = args->mode;
    $filename = str(args->filename);

    $access_mode = args->flags & O_ACCMODE;

    printf("%s-%d\n%s\n%d\n%d\n", comm, pid, $filename, $mode, $access_mode);
}
